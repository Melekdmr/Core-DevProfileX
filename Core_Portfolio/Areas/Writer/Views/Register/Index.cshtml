 *@
 @model Core_Portfolio.Areas.Writer.Models.UserRegisterViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Skydash Admin</title>
    <!-- plugins:css -->
    <link rel="stylesheet" href="~/skydash/vendors/feather/feather.css">
    <link rel="stylesheet" href="~/skydash/vendors/ti-icons/css/themify-icons.css">
    <link rel="stylesheet" href="~/skydash/vendors/css/vendor.bundle.base.css">
    <!-- endinject -->
    <!-- inject:css -->
    <link rel="stylesheet" href="~/skydash/css/vertical-layout-light/style.css">
    <!-- endinject -->
    <link rel="shortcut icon" href="~/skydash/images/favicon.png" />
    <style>
        /* Özel stil tanımlamaları */
        .auth-form-light {
            max-height: 90vh;
            overflow-y: auto;
            padding: 2rem !important;
        }
        
        .form-row {
            display: flex;
            flex-wrap: wrap;
            margin-right: -10px;
            margin-left: -10px;
        }
        
        .form-col {
            flex: 0 0 50%;
            max-width: 50%;
            padding: 0 10px;
        }
        
        .form-group {
            margin-bottom: 1rem;
        }
        
        @@media (max-width: 768px) {
            .form-col {
                flex: 0 0 100%;
                max-width: 100%;
            }
        }
        
        .compact-form .form-group label {
            margin-bottom: 0.25rem;
            font-size: 0.85rem;
        }
        
        .compact-form .form-control {
            padding: 0.5rem 0.75rem;
            height: auto;
        }
        
        .text-danger {
            font-size: 0.8rem;
        }
        
        .auth-form-btn {
            padding: 0.6rem 1rem;
        }
        
        .social-auth-links {
            display: flex;
            gap: 10px;
            margin-bottom: 1rem;
        }
        
        .social-auth-btn {
            flex: 1;
        }
    </style>
</head>

<body>
    <div class="container-scroller">
        <div class="container-fluid page-body-wrapper full-page-wrapper">
            <div class="content-wrapper d-flex align-items-center auth px-0">
                <div class="row w-100 mx-0">
                    <div class="col-lg-5 mx-auto">
                        <div class="auth-form-light text-left py-4 px-4 px-sm-5 compact-form">
                            <div class="brand-logo">
                                <img src="~/skydash/images/logo.svg" alt="logo">
                            </div>
                            <h4>Bir hesabın yok mu?</h4>
                            <h6 class="font-weight-light mb-3">Hemen Kayıt Ol</h6>
                            
                            <form class="pt-2" method="post">
                                <div class="form-row">
                                    <div class="form-col">
                                        <div class="form-group">
                                            <label>Adınız</label>
                                            <span asp-validation-for="Name" class="text-danger"></span>
                                            <input type="text" asp-for="Name" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="form-col">
                                        <div class="form-group">
                                            <label>Soyadınız</label>
                                            <span asp-validation-for="Surname" class="text-danger"></span>
                                            <input type="text" asp-for="Surname" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="form-row">
                                    <div class="form-col">
                                        <div class="form-group">
                                            <label>Kullanıcı Adınız</label>
                                            <span asp-validation-for="UserName" class="text-danger"></span>
                                            <input type="text" asp-for="UserName" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="form-col">
                                        <div class="form-group">
                                            <label>Mail Adresi</label>
                                            <span asp-validation-for="Mail" class="text-danger"></span>
                                            <input type="email" asp-for="Mail" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="form-row">
                                    <div class="form-col">
                                        <div class="form-group">
                                            <label>Şifre</label>
                                            <span asp-validation-for="Password" class="text-danger"></span>
                                            <input type="password" asp-for="Password" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="form-col">
                                        <div class="form-group">
                                            <label>Şifre Tekrar</label>
                                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                            <input type="password" asp-for="ConfirmPassword" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="form-group">
                                    <label>Görsel Url</label>
                                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                                    <input type="text" asp-for="ImageUrl" class="form-control" />
                                </div>
                                
                                <div class="text-danger" asp-validation-summary="ModelOnly"></div>

                                <div class="mt-3">
                                    <button type="submit" class="btn btn-block btn-primary btn-lg font-weight-medium auth-form-btn" asp-action="Index">KAYIT OL</button>
                                </div>
                                
                                <div class="my-2 d-flex justify-content-between align-items-center">
                                    <div class="form-check">
                                        <label class="form-check-label text-muted">
                                            <input type="checkbox" class="form-check-input">
                                            Beni hatırla
                                        </label>
                                    </div>
                                    <a href="#" class="auth-link text-black">Şifremi unuttum?</a>
                                </div>
                                
                                <div class="social-auth-links">
                                    <button type="button" class="btn btn-facebook auth-form-btn social-auth-btn">
                                        <i class="ti-facebook mr-2"></i>Facebook
                                    </button>
                                    <button type="button" class="btn btn-google auth-form-btn social-auth-btn">
                                        <i class="ti-google mr-2"></i>Google
                                    </button>
                                </div>
                                
                                <div class="text-center mt-3 font-weight-light">
                                    Zaten hesabın var mı? <a href="/Writer/Login/Index" class="text-primary">Giriş Yap</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <!-- content-wrapper ends -->
        </div>
        <!-- page-body-wrapper ends -->
    </div>
    <script src="~/skydash/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/skydash/js/off-canvas.js"></script>
    <script src="~/skydash/js/hoverable-collapse.js"></script>
    <script src="~/skydash/js/template.js"></script>
    <script src="~/skydash/js/settings.js"></script>
    <script src="~/skydash/js/todolist.js"></script>
</body>

</html>